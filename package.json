{
  "name": "pomo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm typecheck",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint:tickets": "node scripts/lint-tickets.mjs",
    "lint": "pnpm lint:tickets && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --config vitest.config.ts --coverage",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "explore:ui": "node scripts/explore-ui.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.0",
    "peerjs": "^1.5.5",
    "svelte-routing": "^2.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.0.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.23.1",
    "svelte-check": "^4.1.5",
    "svelte-eslint-parser": "^1.4.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.3.1",
    "vitest": "^4.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
